        {
          "type": "圖片格",
          "html": "<div class=\"eb-block-drag\" title=\"拖曳移動區塊\">⠿</div>\n    <div class=\"eb-ctrl\">\n      <span class=\"eb-ctrl-tag\">圖片格</span>\n      <button class=\"eb-ctrl-btn\" onclick=\"moveBlock('eb-11',-1,event)\">↑</button>\n      <button class=\"eb-ctrl-btn\" onclick=\"moveBlock('eb-11',1,event)\">↓</button>\n      <button class=\"eb-ctrl-btn del\" onclick=\"deleteBlock('eb-11',event)\">✕</button>\n    </div>\n      <div class=\"eb-grid-toolbar\">\n        <label>欄數</label>\n        <input type=\"range\" min=\"1\" max=\"5\" value=\"2\" id=\"gc-12\" oninput=\"updateGridCols('12')\">\n        <span class=\"cols-val\" id=\"gcv-12\">2</span>\n        <button class=\"add-img-btn\" onclick=\"addGridCell('12',event)\">＋ 加圖</button>\n      </div>\n      <div class=\"eb-grid\" id=\"grid-12\" style=\"grid-template-columns: repeat(2, 1fr);\">\n        \n    \n        \n    <div class=\"eb-grid-cell\" style=\"grid-area: span 9 / span 1;\" data-span=\"9\" data-col-span=\"1\">\n      <div class=\"eb-cell-move-handle\" title=\"拖曳移動格子\"></div>\n      <button class=\"eb-cell-del-btn\" onclick=\"this.closest('.eb-grid-cell').remove();event.stopPropagation()\">✕</button>\n      <button class=\"eb-cell-yt-btn\" onclick=\"doGridCellYoutube(this.closest('.eb-grid-cell'));event.stopPropagation()\" title=\"嵌入 YouTube 影片\">YT</button>\n      \n      <div class=\"eb-cell-size-tag\">1欄 × 9列</div>\n      <div class=\"eb-cell-resize-handle\" title=\"拖曳調整高度\"></div>\n      <div class=\"eb-cell-resize-col\" title=\"拖曳調整寬度\"></div>\n    <video src=\"https://res.cloudinary.com/dy1pm9tnu/video/upload/v1781378008/portfolio/installation/wnqafywrcq23gdi3ww76.mp4\" autoplay=\"\" muted=\"\" loop=\"\" playsinline=\"\" style=\"width: 100%; height: 100%; object-fit: cover; position: absolute; inset: 0px; z-index: 0; cursor: pointer;\"></video></div>\n        \n    \n      <div class=\"eb-grid-cell\" style=\"grid-area: span 4 / span 1;\" data-span=\"4\" data-col-span=\"1\" draggable=\"false\">\n